\PYG{c+cm}{/*}
\PYG{c+cm}{   USAGE EXAMPLE:}
\PYG{c+cm}{   signed main() \PYGZob{}}
\PYG{c+cm}{     LineContainer lc;}
\PYG{c+cm}{     // \PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}}
\PYG{c+cm}{     // EXAMPLE 1: MAXIMUM QUERIES (Default behavior)}
\PYG{c+cm}{     // \PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}}
\PYG{c+cm}{     // Add lines: y = 2x + 3, y = 1x + 10, y = 3x \PYGZhy{} 5}
\PYG{c+cm}{     lc.add(2, 3);}
\PYG{c+cm}{     lc.add(1, 10);}
\PYG{c+cm}{     lc.add(3, \PYGZhy{}5);}
\PYG{c+cm}{     }
\PYG{c+cm}{     cout \PYGZlt{}\PYGZlt{} \PYGZdq{}Max at x=2: \PYGZdq{} \PYGZlt{}\PYGZlt{} lc.query(2) \PYGZlt{}\PYGZlt{} \PYGZdq{}\PYGZbs{}n\PYGZdq{}; // y = 1*(2) + 10 = 12}
\PYG{c+cm}{     cout \PYGZlt{}\PYGZlt{} \PYGZdq{}Max at x=10: \PYGZdq{} \PYGZlt{}\PYGZlt{} lc.query(10) \PYGZlt{}\PYGZlt{} \PYGZdq{}\PYGZbs{}n\PYGZdq{}; // y = 3*(10) \PYGZhy{} 5 = 25}
\PYG{c+cm}{     }
\PYG{c+cm}{     // \PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}}
\PYG{c+cm}{     // EXAMPLE 2: MINIMUM QUERIES (Trick)}
\PYG{c+cm}{     // \PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}}
\PYG{c+cm}{     LineContainer min\PYGZus{}lc;}
\PYG{c+cm}{     }
\PYG{c+cm}{     // We want to find MINIMUM of: y = 2x + 3, y = 1x + 10, y = 3x \PYGZhy{} 5}
\PYG{c+cm}{     // Trick: Insert (\PYGZhy{}k, \PYGZhy{}m)}
\PYG{c+cm}{     min\PYGZus{}lc.add(\PYGZhy{}2, \PYGZhy{}3);}
\PYG{c+cm}{     min\PYGZus{}lc.add(\PYGZhy{}1, \PYGZhy{}10);}
\PYG{c+cm}{     min\PYGZus{}lc.add(\PYGZhy{}3, 5); // \PYGZhy{}(\PYGZhy{}5) = 5}
\PYG{c+cm}{     }
\PYG{c+cm}{     // Trick: Negate the query result}
\PYG{c+cm}{     cout \PYGZlt{}\PYGZlt{} \PYGZdq{}Min at x=2: \PYGZdq{} \PYGZlt{}\PYGZlt{} \PYGZhy{}min\PYGZus{}lc.query(2) \PYGZlt{}\PYGZlt{} \PYGZdq{}\PYGZbs{}n\PYGZdq{};  // y = 2*(2) + 3 = 7}
\PYG{c+cm}{     cout \PYGZlt{}\PYGZlt{} \PYGZdq{}Min at x=10: \PYGZdq{} \PYGZlt{}\PYGZlt{} \PYGZhy{}min\PYGZus{}lc.query(10) \PYGZlt{}\PYGZlt{} \PYGZdq{}\PYGZbs{}n\PYGZdq{}; // y = 1*(10) + 10 = 20}
\PYG{c+cm}{     }
\PYG{c+cm}{     return 0;}
\PYG{c+cm}{   \PYGZcb{}}
