\PYG{+w}{        }\PYG{n}{state}\PYG{p}{.}\PYG{n}{add}\PYG{p}{(}\PYG{n}{rn}\PYG{p}{[}\PYG{n}{i}\PYG{p}{]);}
\PYG{+w}{      }\PYG{p}{\PYGZcb{}}
\PYG{+w}{    }\PYG{p}{\PYGZcb{}}
\PYG{+w}{  }\PYG{p}{\PYGZcb{}}
\PYG{+w}{  }\PYG{n}{state}\PYG{p}{.}\PYG{n}{add}\PYG{p}{(}\PYG{n}{u}\PYG{p}{);}\PYG{+w}{ }\PYG{c+c1}{// Add the current node itself}
\PYG{+w}{  }
\PYG{+w}{  }\PYG{c+c1}{// Step 2.4: ANSWER QUERIES for node `u` here}
\PYG{+w}{  }\PYG{c+c1}{// for (auto query : queries[u]) \PYGZob{}}
