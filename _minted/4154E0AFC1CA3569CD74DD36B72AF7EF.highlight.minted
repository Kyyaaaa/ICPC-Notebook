\PYG{c+cm}{/*}
\PYG{c+cm}{   DINIC\PYGZsq{}S ALGORITHM (Max Flow \PYGZam{} Min Cut)}
\PYG{c+cm}{   Idea:}
\PYG{c+cm}{   \PYGZhy{} Phase 1 (BFS): Build a \PYGZdq{}Level Graph\PYGZdq{}. Assign levels to nodes based on }
\PYG{c+cm}{     shortest path from Source (S). Only edges that go to the next level }
\PYG{c+cm}{     (level[v] == level[u] + 1) are considered valid.}
\PYG{c+cm}{   \PYGZhy{} Phase 2 (DFS): Push as much flow as possible along the Level Graph.}
\PYG{c+cm}{   \PYGZhy{} DEAD\PYGZhy{}END OPTIMIZATION (ptr array): During DFS, if an edge leads to a }
\PYG{c+cm}{     dead end (can\PYGZsq{}t push any more flow), we advance the `ptr` so we NEVER }
\PYG{c+cm}{     visit this useless edge again in the current BFS phase.}
\PYG{c+cm}{   Complexity: }
\PYG{c+cm}{   \PYGZhy{} General Graph: O(V\PYGZca{}2 * E)}
\PYG{c+cm}{   \PYGZhy{} Unit Network (e.g., Bipartite Matching): O(E * sqrt(V))}
\PYG{c+cm}{   \PYGZhy{} Extremely fast in practice, much faster than Edmonds\PYGZhy{}Karp.}
\PYG{c+cm}{*/}
