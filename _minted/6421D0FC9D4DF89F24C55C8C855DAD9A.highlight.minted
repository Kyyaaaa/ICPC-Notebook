\PYG{+w}{      }\PYG{k}{if}\PYG{+w}{ }\PYG{p}{(}\PYG{n}{op}\PYG{p}{.}\PYG{n}{added\PYGZus{}violation}\PYG{p}{)}\PYG{+w}{ }\PYG{p}{\PYGZob{}}
\PYG{+w}{        }\PYG{n}{bipartite\PYGZus{}violations}\PYG{o}{\PYGZhy{}\PYGZhy{}}\PYG{p}{;}
