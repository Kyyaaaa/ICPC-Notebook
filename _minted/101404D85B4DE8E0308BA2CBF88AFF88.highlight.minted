\PYG{c+c1}{//   k = 0: sort by first; k = 1: sort by second.}
\PYG{c+c1}{//   lo, hi: min/max value of component k (inclusive).}
\PYG{c+c1}{//   asc = true: ascending; false: descending.}
\PYG{c+c1}{//   Stable: equal keys preserve their relative order.}
\PYG{c+c1}{//   Time: O(n + R), Memory: O(n + R), R = hi \PYGZhy{} lo + 1.}
\PYG{c+c1}{// Note: All component values must be within their specified ranges.}
\PYG{c+c1}{// Note: Use counting sort when value ranges are small enough.}

