\PYG{c+cm}{/*}
\PYG{c+cm}{   Idea:}
\PYG{c+cm}{   \PYGZhy{} Repeatedly find an augmenting path from Source (S) to Sink (T) using BFS.}
\PYG{c+cm}{   \PYGZhy{} Bottleneck of the path is the minimum remaining capacity among its edges.}
\PYG{c+cm}{   \PYGZhy{} Push the bottleneck flow through the path, and ADD it to the reverse }
\PYG{c+cm}{     edges (to allow \PYGZdq{}undoing\PYGZdq{} flow later).}
\PYG{c+cm}{   \PYGZhy{} Terminates when no more augmenting paths can be found.}
\PYG{c+cm}{   Complexity: O(V * E\PYGZca{}2). Safe for V \PYGZlt{}= 1000, E \PYGZlt{}= 5000.}
\PYG{c+cm}{*/}
