\PYG{c+cm}{/*}
\PYG{c+cm}{   Idea:}
\PYG{c+cm}{   \PYGZhy{} 1\PYGZhy{}based indexing for a grid of size N x M.}
\PYG{c+cm}{   \PYGZhy{} When we add `v` to a 2D difference array at (i, j), it contributes to }
\PYG{c+cm}{     the prefix sum S(X, Y) (where X \PYGZgt{}= i and Y \PYGZgt{}= j) by:}
\PYG{c+cm}{     v * (X \PYGZhy{} i + 1) * (Y \PYGZhy{} j + 1)}
\PYG{c+cm}{     = v * [ (X+1)(Y+1) \PYGZhy{} (X+1)*j \PYGZhy{} (Y+1)*i + i*j ]}
\PYG{c+cm}{   \PYGZhy{} To maintain this, we need 4 2D BITs to store the sum of:}
\PYG{c+cm}{     1. v}
\PYG{c+cm}{     2. v * i}
\PYG{c+cm}{     3. v * j}
\PYG{c+cm}{     4. v * i * j}
\PYG{c+cm}{*/}

