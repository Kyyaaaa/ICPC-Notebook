\PYG{+w}{      }\PYG{n}{sum}\PYG{+w}{ }\PYG{o}{+=}\PYG{+w}{ }\PYG{n}{bit}\PYG{p}{[}\PYG{n}{next\PYGZus{}pos}\PYG{p}{];}
