\PYG{c+cm}{/*}
\PYG{c+cm}{   INTERVAL CONTAINER (DISJOINT INTERVALS SET)}
\PYG{c+cm}{   Idea:}
\PYG{c+cm}{   \PYGZhy{} Maintains a set of disjoint intervals [L, R].}
\PYG{c+cm}{   \PYGZhy{} Automatically merges overlapping or adjacent intervals when adding.}
\PYG{c+cm}{   \PYGZhy{} Automatically splits intervals when removing a segment.}
\PYG{c+cm}{   \PYGZhy{} Dynamically maintains the total length/count of covered points.}
\PYG{c+cm}{   Complexity:}
\PYG{c+cm}{   \PYGZhy{} add\PYGZus{}interval: Amortized O(log N)}
\PYG{c+cm}{   \PYGZhy{} remove\PYGZus{}interval: Amortized O(log N)}
\PYG{c+cm}{   \PYGZhy{} contains: O(log N)}
\PYG{c+cm}{*/}
