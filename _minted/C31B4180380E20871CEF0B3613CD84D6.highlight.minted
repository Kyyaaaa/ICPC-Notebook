\PYG{c+cm}{/* =========================================================================}
\PYG{c+cm}{   MIN COST MAX FLOW (Dijkstra with Johnson\PYGZsq{}s Potentials)}
\PYG{c+cm}{   }
\PYG{c+cm}{   Idea:}
\PYG{c+cm}{   \PYGZhy{} Uses Dijkstra instead of SPFA to find the cheapest augmenting path.}
\PYG{c+cm}{   \PYGZhy{} Maintains a potential function `pi` for each node to handle negative }
\PYG{c+cm}{     weight residual edges.}
\PYG{c+cm}{   \PYGZhy{} Edge weights are reweighted: w\PYGZsq{}(u, v) = w(u, v) + pi[u] \PYGZhy{} pi[v] \PYGZgt{}= 0.}
\PYG{c+cm}{   \PYGZhy{} Complexity: O(F * E log V) where F is the flow. Fast and safe!}
\PYG{c+cm}{========================================================================= */}
