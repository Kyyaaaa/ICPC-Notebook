\PYG{c+cm}{   NOTES:}
\PYG{c+cm}{   \PYGZhy{} Do NOT call two solve methods on the same object.}
\PYG{c+cm}{   \PYGZhy{} Do NOT add t \PYGZhy{}\PYGZgt{} s yourself when using max\PYGZus{}flow/min\PYGZus{}flow/feasible\PYGZus{}flow.}
