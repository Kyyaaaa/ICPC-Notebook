\PYG{c+cm}{   USAGE EXAMPLES:}

\PYG{c+cm}{   // 1. Maximum s \PYGZhy{}\PYGZgt{} t flow:}
\PYG{c+cm}{   LowerBoundFlow f(n);}
\PYG{c+cm}{   int id = f.add\PYGZus{}edge(1, 2, 2, 5);}
\PYG{c+cm}{   f.add\PYGZus{}edge(2, 3, 1, 7);}

\PYG{c+cm}{   auto [ok, ans] = f.max\PYGZus{}flow(1, 3);}
\PYG{c+cm}{   if (!ok) cout \PYGZlt{}\PYGZlt{} \PYGZhy{}1 \PYGZlt{}\PYGZlt{} \PYGZsq{}\PYGZbs{}n\PYGZsq{};}
\PYG{c+cm}{   else \PYGZob{}}
\PYG{c+cm}{     cout \PYGZlt{}\PYGZlt{} \PYGZdq{}Max Flow: \PYGZdq{} \PYGZlt{}\PYGZlt{} ans \PYGZlt{}\PYGZlt{} \PYGZsq{}\PYGZbs{}n\PYGZsq{};}
\PYG{c+cm}{     cout \PYGZlt{}\PYGZlt{} \PYGZdq{}Flow on edge id: \PYGZdq{} \PYGZlt{}\PYGZlt{} f.get\PYGZus{}flow(id) \PYGZlt{}\PYGZlt{} \PYGZsq{}\PYGZbs{}n\PYGZsq{};}
