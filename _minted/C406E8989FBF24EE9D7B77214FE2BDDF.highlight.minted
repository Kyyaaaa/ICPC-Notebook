\PYG{c+cm}{   \PYGZcb{}}

\PYG{c+cm}{   // 2. Minimum NON\PYGZhy{}NEGATIVE s \PYGZhy{}\PYGZgt{} t flow (use a NEW object):}
\PYG{c+cm}{   LowerBoundFlow g(n);}
\PYG{c+cm}{   // g.add\PYGZus{}edge(u, v, l, r);}
\PYG{c+cm}{   auto [ok2, min\PYGZus{}ans] = g.min\PYGZus{}flow(s, t);}

\PYG{c+cm}{   // 3. Feasible circulation (no designated source/sink):}
\PYG{c+cm}{   LowerBoundFlow h(n);}
\PYG{c+cm}{   // h.add\PYGZus{}edge(u, v, l, r);}
\PYG{c+cm}{   bool possible = h.feasible\PYGZus{}circulation();}

\PYG{c+cm}{   // 4. Just check whether a non\PYGZhy{}negative s \PYGZhy{}\PYGZgt{} t flow exists:}
