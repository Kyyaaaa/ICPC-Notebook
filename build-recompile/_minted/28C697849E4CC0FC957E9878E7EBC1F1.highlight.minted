\PYG{c+cm}{/*}
\PYG{c+cm}{   USAGE EXAMPLE:}
\PYG{c+cm}{   }
\PYG{c+cm}{   signed main() \PYGZob{}}
\PYG{c+cm}{     AhoCorasick ac;}
\PYG{c+cm}{     }
\PYG{c+cm}{     vector\PYGZlt{}string\PYGZgt{} patterns = \PYGZob{}\PYGZdq{}he\PYGZdq{}, \PYGZdq{}she\PYGZdq{}, \PYGZdq{}his\PYGZdq{}, \PYGZdq{}hers\PYGZdq{}\PYGZcb{};}
\PYG{c+cm}{     for (int i = 0; i \PYGZlt{} patterns.size(); i++) \PYGZob{}}
\PYG{c+cm}{       ac.insert(patterns[i], i);}
\PYG{c+cm}{     \PYGZcb{}}
\PYG{c+cm}{     }
\PYG{c+cm}{     // MUST call build() after inserting all patterns and before searching}
\PYG{c+cm}{     ac.build();}
\PYG{c+cm}{     }
\PYG{c+cm}{     string text = \PYGZdq{}ushers\PYGZdq{};}
\PYG{c+cm}{     cout \PYGZlt{}\PYGZlt{} \PYGZdq{}Searching in text: \PYGZdq{} \PYGZlt{}\PYGZlt{} text \PYGZlt{}\PYGZlt{} \PYGZdq{}\PYGZbs{}n\PYGZdq{};}
\PYG{c+cm}{     ac.search(text);}
\PYG{c+cm}{     }
\PYG{c+cm}{     // Output expected:}
\PYG{c+cm}{     // Pattern ID 1 (\PYGZdq{}she\PYGZdq{}) ends at index 3}
\PYG{c+cm}{     // Pattern ID 0 (\PYGZdq{}he\PYGZdq{}) ends at index 3}
\PYG{c+cm}{     // Pattern ID 3 (\PYGZdq{}hers\PYGZdq{}) ends at index 5}
\PYG{c+cm}{     }
\PYG{c+cm}{     return 0;}
\PYG{c+cm}{   \PYGZcb{}}
\PYG{c+cm}{*/}
