\PYG{c+cm}{/*}
\PYG{c+cm}{   AHO\PYGZhy{}CORASICK AUTOMATON}
\PYG{c+cm}{   Idea:}
\PYG{c+cm}{   \PYGZhy{} Multi\PYGZhy{}pattern string search algorithm. }
\PYG{c+cm}{   \PYGZhy{} Constructs a Trie from a set of patterns and adds:}
\PYG{c+cm}{     1. Failure Links (`fail`): Where to go when a character mismatch occurs.}
\PYG{c+cm}{     2. Output Links (`output`): Direct link to the nearest valid pattern }
\PYG{c+cm}{        ending in the failure chain (handles overlapping/substring patterns).}
\PYG{c+cm}{   \PYGZhy{} OPTIMIZATION: We convert the Trie into a Deterministic Finite Automaton }
\PYG{c+cm}{     (DFA). Transition `next[c]` either points to the actual child OR the }
\PYG{c+cm}{     fallback state in O(1).}
\PYG{c+cm}{     }
\PYG{c+cm}{   Complexity:}
\PYG{c+cm}{   \PYGZhy{} Build Time: O(Sum of pattern lengths * Alphabet Size)}
\PYG{c+cm}{   \PYGZhy{} Search Time: O(Length of Text + Number of Matches)}
\PYG{c+cm}{*/}

