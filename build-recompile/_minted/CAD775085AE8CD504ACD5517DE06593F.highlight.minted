\PYG{c+cm}{/*}
\PYG{c+cm}{   USAGE EXAMPLE (Handling Map for Edge Lifespans):}
\PYG{c+cm}{   }
\PYG{c+cm}{   signed main() \PYGZob{}}
\PYG{c+cm}{     int n = 5;  // 5 nodes}
\PYG{c+cm}{     int q = 6;  // 6 events/queries}
\PYG{c+cm}{     }
\PYG{c+cm}{     DynamicConnectivity dc(n, q);}
\PYG{c+cm}{     map\PYGZlt{}pair\PYGZlt{}int, int\PYGZgt{}, int\PYGZgt{} edge\PYGZus{}start;}
\PYG{c+cm}{     }
\PYG{c+cm}{     // Note: Always normalize edges so u \PYGZlt{} v to avoid \PYGZob{}u, v\PYGZcb{} and \PYGZob{}v, u\PYGZcb{} mix\PYGZhy{}ups.}
\PYG{c+cm}{     auto normalize = [](int u, int v) \PYGZob{}}
\PYG{c+cm}{       return u \PYGZlt{} v ? make\PYGZus{}pair(u, v) : make\PYGZus{}pair(v, u);}
\PYG{c+cm}{     \PYGZcb{};}
\PYG{c+cm}{     }
\PYG{c+cm}{     // Simulating reading queries:}
\PYG{c+cm}{     // Time 1: Add edge (1, 2)}
\PYG{c+cm}{     edge\PYGZus{}start[normalize(1, 2)] = 1;}
\PYG{c+cm}{     }
\PYG{c+cm}{     // Time 2: Add edge (2, 3)}
\PYG{c+cm}{     edge\PYGZus{}start[normalize(2, 3)] = 2;}
\PYG{c+cm}{     }
\PYG{c+cm}{     // Time 3: Query (1, 3) \PYGZhy{}\PYGZgt{} should be connected}
\PYG{c+cm}{     dc.add\PYGZus{}query(1, 3, 3);}
\PYG{c+cm}{     }
\PYG{c+cm}{     // Time 4: Remove edge (1, 2)}
\PYG{c+cm}{     pair\PYGZlt{}int, int\PYGZgt{} e = normalize(1, 2);}
\PYG{c+cm}{     dc.add\PYGZus{}edge(e.first, e.second, edge\PYGZus{}start[e], 4 \PYGZhy{} 1); }
\PYG{c+cm}{     edge\PYGZus{}start.erase(e); // Edge doesn\PYGZsq{}t exist after time 3}
\PYG{c+cm}{     }
\PYG{c+cm}{     // Time 5: Query (1, 3) \PYGZhy{}\PYGZgt{} should NOT be connected}
\PYG{c+cm}{     dc.add\PYGZus{}query(1, 3, 5);}
\PYG{c+cm}{     }
\PYG{c+cm}{     // Time 6: Add edge (1, 3)}
\PYG{c+cm}{     edge\PYGZus{}start[normalize(1, 3)] = 6;}
\PYG{c+cm}{     }
\PYG{c+cm}{     // IMPORTANT: Close any edges that were never removed!}
\PYG{c+cm}{     for (auto it : edge\PYGZus{}start) \PYGZob{}}
\PYG{c+cm}{       dc.add\PYGZus{}edge(it.first.first, it.first.second, it.second, q);}
\PYG{c+cm}{     \PYGZcb{}}
\PYG{c+cm}{     }
\PYG{c+cm}{     // Solve and print}
\PYG{c+cm}{     vector\PYGZlt{}int\PYGZgt{} results = dc.solve();}
\PYG{c+cm}{     for (int res : results) \PYGZob{}}
\PYG{c+cm}{       cout \PYGZlt{}\PYGZlt{} (res ? \PYGZdq{}YES\PYGZdq{} : \PYGZdq{}NO\PYGZdq{}) \PYGZlt{}\PYGZlt{} \PYGZdq{}\PYGZbs{}n\PYGZdq{};}
\PYG{c+cm}{     \PYGZcb{}}
\PYG{c+cm}{     }
\PYG{c+cm}{     // Expected Output:}
\PYG{c+cm}{     // YES (at time 3)}
\PYG{c+cm}{     // NO (at time 5)}
\PYG{c+cm}{     }
\PYG{c+cm}{     return 0;}
