\PYG{c+cm}{/*}
\PYG{c+cm}{  \PYGZhy{} For a boolean variable x, we create two nodes: x (1..n) and NOT(x) (n+1..2n).}
\PYG{c+cm}{  \PYGZhy{} A clause (x OR y) is equivalent to: (!x =\PYGZgt{} y) and (!y =\PYGZgt{} x).}
\PYG{c+cm}{  \PYGZhy{} If x and NOT(x) are in the same Strongly Connected Component (SCC), }
\PYG{c+cm}{    it\PYGZsq{}s a contradiction \PYGZhy{}\PYGZgt{} NO solution.}
\PYG{c+cm}{  \PYGZhy{} We assign TRUE to x if its SCC is topologically sorted AFTER NOT(x)\PYGZsq{}s SCC.}
\PYG{c+cm}{    (Tarjan assigns SCC IDs in reverse topological order, so col[x] \PYGZlt{} col[NOT(x)])}
\PYG{c+cm}{*/}

