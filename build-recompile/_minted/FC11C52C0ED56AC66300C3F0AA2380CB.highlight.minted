\PYG{c+cm}{/*}
\PYG{c+cm}{   SUFFIX ARRAY \PYGZam{} LCP ARRAY (O(N log N) Construction)}
\PYG{c+cm}{   Idea:}
\PYG{c+cm}{   \PYGZhy{} Suffix Array (sa): Sorts all suffixes of a string lexicographically. }
\PYG{c+cm}{     sa[i] stores the starting index of the i\PYGZhy{}th lexicographically }
\PYG{c+cm}{     smallest suffix.}
\PYG{c+cm}{   \PYGZhy{} LCP Array (lcp): Stores the Longest Common Prefix between consecutive }
\PYG{c+cm}{     suffixes in the sorted Suffix Array. lcp[i] = LCP(sa[i], sa[i\PYGZhy{}1]).}
\PYG{c+cm}{   Algorithm:}
\PYG{c+cm}{   \PYGZhy{} Appends a special character \PYGZsq{}\PYGZdl{}\PYGZsq{} (strictly smaller than all other characters) }
\PYG{c+cm}{     to the end of the string.}
\PYG{c+cm}{   \PYGZhy{} Sorts substrings of length 2\PYGZca{}k using Radix Sort in O(N).}
\PYG{c+cm}{   \PYGZhy{} Repeats log(N) times \PYGZhy{}\PYGZgt{} Total time O(N log N).}
\PYG{c+cm}{   \PYGZhy{} Computes LCP in O(N) using Kasai\PYGZsq{}s Algorithm.}
\PYG{c+cm}{*/}

