\PYG{c+cm}{/*}
\PYG{c+cm}{   LUCAS THEOREM}
\PYG{c+cm}{   Idea:}
\PYG{c+cm}{   \PYGZhy{} Computes nCr(n, k) \PYGZpc{} p where n and k can be very large (up to 10\PYGZca{}18), }
\PYG{c+cm}{     but p is a relatively small PRIME number (e.g., p \PYGZlt{}= 10\PYGZca{}6).}
\PYG{c+cm}{   \PYGZhy{} Theorem: nCr(n, k) = Product of nCr(n\PYGZus{}i, k\PYGZus{}i) (mod p), where n\PYGZus{}i and }
\PYG{c+cm}{     k\PYGZus{}i are the digits of n and k in base p.}
\PYG{c+cm}{   \PYGZhy{} If at any point k\PYGZus{}i \PYGZgt{} n\PYGZus{}i, then nCr(n\PYGZus{}i, k\PYGZus{}i) = 0, meaning the entire }
\PYG{c+cm}{     result becomes 0.}
\PYG{c+cm}{   Complexity:}
\PYG{c+cm}{   \PYGZhy{} Precomputation: O(p) to compute factorials up to p \PYGZhy{} 1.}
\PYG{c+cm}{   \PYGZhy{} Query: O(log\PYGZus{}p(n)) per nCr query.}
\PYG{c+cm}{   \PYGZhy{} Space: O(p)}
\PYG{c+cm}{   Requirement:}
\PYG{c+cm}{   \PYGZhy{} p MUST be a prime number.}
\PYG{c+cm}{*/}
