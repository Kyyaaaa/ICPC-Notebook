\begin{MintedVerbatim}[commandchars=\\\{\}]
\PYG{c+cm}{/*}
\PYG{c+cm}{   MO\PYGZsq{}S ALGORITHM ON TREES (WITH UPDATES \PYGZhy{} 3D MO)}
\PYG{c+cm}{   Idea:}
\PYG{c+cm}{   \PYGZhy{} Flattens the tree into an array using Euler Tour. Each node appears }
\PYG{c+cm}{     exactly TWICE: when we enter it (tin) and when we leave it (tout).}
\PYG{c+cm}{   \PYGZhy{} A node is considered \PYGZdq{}in the current path\PYGZdq{} if it appears exactly ONCE }
\PYG{c+cm}{     in our active range [L, R]. We maintain a boolean array `f[u]` to }
\PYG{c+cm}{     toggle the presence of node `u`.}
\PYG{c+cm}{     }
\PYG{c+cm}{   Query Translation (Path from U to V, assuming tin[U] \PYGZlt{} tin[V]):}
\PYG{c+cm}{   \PYGZhy{} Case 1: U is an ancestor of V. }
\PYG{c+cm}{             Query range: [tin[U], tin[V]]. LCA is already included.}
\PYG{c+cm}{   \PYGZhy{} Case 2: U is NOT an ancestor of V.}
\PYG{c+cm}{             Query range: [tout[U], tin[V]]. LCA is NOT in this range, }
\PYG{c+cm}{             so we must manually add/remove the LCA during the query.}
\PYG{c+cm}{   Complexity:}
\PYG{c+cm}{   \PYGZhy{} Without updates (2D Mo): Block size = N / sqrt(Q), Time = O(N * sqrt(Q))}
\PYG{c+cm}{   \PYGZhy{} With updates (3D Mo): Block size = N\PYGZca{}(2/3), Time = O(N\PYGZca{}(5/3))}
\PYG{c+cm}{*/}
\PYG{k}{const}\PYG{+w}{ }\PYG{k+kt}{int}\PYG{+w}{ }\PYG{n}{N}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{l+m+mf}{2e5}\PYG{+w}{ }\PYG{o}{+}\PYG{+w}{ }\PYG{l+m+mi}{5}\PYG{p}{;}
\PYG{c+c1}{// For 3D Mo (with updates), BLOCK size should be roughly N\PYGZca{}(2/3). }
\PYG{c+c1}{// For N = 100,000, N\PYGZca{}(2/3) is approx 2150.}
\PYG{k}{const}\PYG{+w}{ }\PYG{k+kt}{int}\PYG{+w}{ }\PYG{n}{BLOCK}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{l+m+mi}{2150}\PYG{p}{;}\PYG{+w}{ }

